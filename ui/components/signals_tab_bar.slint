import { Theme } from "../styles/theme.slint";

// Discrete bottom tab bar for switching between Intentions, Liens, Moments and Settings
export component SignalsTabBar inherits VerticalLayout {
    in-out property <int> active_tab: 0; // 0 = Intentions, 1 = Liens, 2 = Moments, 3 = Settings

    callback select_tab(int);
    callback open_settings();
    callback return_home();

    spacing: 10px;
    padding-top: 10px;
    padding-bottom: 8px;

    // Row of 3 tabs + settings icon
    HorizontalLayout {
        alignment: space-between;
        padding-left: 6px;
        padding-right: 6px;

        // The 3 presentation tabs
        HorizontalLayout {
            spacing: 20px;
            alignment: start;

            // Tab 0: Intentions
            tab0_touch := TouchArea {
                clicked => { root.select_tab(0); }

                VerticalLayout {
                    spacing: 4px;
                    alignment: center;

                    Text {
                        text: "Intentions";
                        font-family: Theme.font_main;
                        font-size: 13px;
                        font-weight: root.active_tab == 0 ? 600 : 400;
                        color: root.active_tab == 0 ? Theme.text_primary : Theme.text_muted;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: root.active_tab == 0 ? Theme.pastel_purple : transparent;
                    }
                }
            }

            // Tab 1: Liens
            tab1_touch := TouchArea {
                clicked => { root.select_tab(1); }

                VerticalLayout {
                    spacing: 4px;
                    alignment: center;

                    Text {
                        text: "Liens";
                        font-family: Theme.font_main;
                        font-size: 13px;
                        font-weight: root.active_tab == 1 ? 600 : 400;
                        color: root.active_tab == 1 ? Theme.text_primary : Theme.text_muted;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: root.active_tab == 1 ? Theme.pastel_purple : transparent;
                    }
                }
            }

            // Tab 2: Moments
            tab2_touch := TouchArea {
                clicked => { root.select_tab(2); }

                VerticalLayout {
                    spacing: 4px;
                    alignment: center;

                    Text {
                        text: "Moments";
                        font-family: Theme.font_main;
                        font-size: 13px;
                        font-weight: root.active_tab == 2 ? 600 : 400;
                        color: root.active_tab == 2 ? Theme.text_primary : Theme.text_muted;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 4px;
                        height: 4px;
                        border-radius: 2px;
                        background: root.active_tab == 2 ? Theme.pastel_purple : transparent;
                    }
                }
            }
        }

        // Right Settings / Filter button
        settings_touch := TouchArea {
            width: 32px;
            height: 24px;
            clicked => { root.open_settings(); }

            // Geometric sliders/filter vector icon
            Rectangle {
                width: 18px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: transparent;

                // Slider line 1
                Rectangle { x: 0px; y: 2px; width: 18px; height: 1.5px; background: Theme.text_muted; }
                Rectangle { x: 4px; y: 0.5px; width: 4px; height: 4.5px; border-radius: 1px; background: root.active_tab == 3 ? Theme.pastel_purple : Theme.text_secondary; }

                // Slider line 2
                Rectangle { x: 0px; y: 10px; width: 18px; height: 1.5px; background: Theme.text_muted; }
                Rectangle { x: 10px; y: 8.5px; width: 4px; height: 4.5px; border-radius: 1px; background: root.active_tab == 3 ? Theme.pastel_purple : Theme.text_secondary; }
            }
        }
    }

    // Bottom tactile gesture bar (tap to return to Home)
    HorizontalLayout {
        alignment: center;

        home_touch := TouchArea {
            height: 20px;
            width: 140px;
            clicked => { root.return_home(); }

            Rectangle {
                width: 100px;
                height: 4px;
                border-radius: 2px;
                background: home_touch.pressed ? Theme.pastel_purple : Theme.text_muted;
                opacity: home_touch.pressed ? 1.0 : 0.6;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                animate background, opacity { duration: Theme.anim_fast; }
            }
        }
    }
}
