import { Theme } from "../styles/theme.slint";

// Four discrete minimalist circular dock shortcuts
export component Dock inherits HorizontalLayout {
    in-out property <bool> show_all_apps: true;

    callback open_phone();
    callback open_messages();
    callback open_camera();
    callback open_apps();

    alignment: space-around;
    padding-top: 10px;
    padding-bottom: 6px;

    // --- SHORTCUT 1: Telephone ---
    phone_touch := TouchArea {
        width: 68px;
        clicked => { root.open_phone(); }

        VerticalLayout {
            spacing: 6px;
            alignment: center;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: Theme.border_radius_pill;
                    background: phone_touch.pressed ? Theme.surface_light : Theme.surface;
                    border-width: 1px;
                    border-color: phone_touch.pressed ? Theme.surface_border_light : Theme.surface_border;

                    animate background, border-color { duration: Theme.anim_fast; }

                    // Vector handset silhouette
                    Path {
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        stroke: Theme.text_primary;
                        stroke-width: 1.6px;

                        MoveTo { x: 3; y: 2; }
                        LineTo { x: 6; y: 2; }
                        LineTo { x: 7.5; y: 5.5; }
                        LineTo { x: 5.5; y: 7; }
                        LineTo { x: 9; y: 10.5; }
                        LineTo { x: 10.5; y: 8.5; }
                        LineTo { x: 14; y: 10; }
                        LineTo { x: 14; y: 13; }
                        LineTo { x: 12; y: 14; }
                        LineTo { x: 2; y: 4; }
                        Close {}
                    }
                }
            }

            Text {
                text: "Telephone";
                font-family: Theme.font_main;
                font-size: 11px;
                color: Theme.text_secondary;
                horizontal-alignment: center;
            }
        }
    }

    // --- SHORTCUT 2: Messages ---
    msg_touch := TouchArea {
        width: 68px;
        clicked => { root.open_messages(); }

        VerticalLayout {
            spacing: 6px;
            alignment: center;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: Theme.border_radius_pill;
                    background: msg_touch.pressed ? Theme.surface_light : Theme.surface;
                    border-width: 1px;
                    border-color: msg_touch.pressed ? Theme.surface_border_light : Theme.surface_border;

                    animate background, border-color { duration: Theme.anim_fast; }

                    // Vector speech bubble
                    Rectangle {
                        width: 17px;
                        height: 13px;
                        border-radius: 4px;
                        border-width: 1.6px;
                        border-color: Theme.text_primary;
                        background: transparent;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2 - 1px;

                        // Little bubble tail
                        Path {
                            width: 5px;
                            height: 4px;
                            x: 3px;
                            y: parent.height - 1px;
                            fill: Theme.text_primary;

                            MoveTo { x: 0; y: 0; }
                            LineTo { x: 5; y: 0; }
                            LineTo { x: 1; y: 4; }
                            Close {}
                        }
                    }
                }
            }

            Text {
                text: "Messages";
                font-family: Theme.font_main;
                font-size: 11px;
                color: Theme.text_secondary;
                horizontal-alignment: center;
            }
        }
    }

    // --- SHORTCUT 3: Appareil photo ---
    cam_touch := TouchArea {
        width: 68px;
        clicked => { root.open_camera(); }

        VerticalLayout {
            spacing: 6px;
            alignment: center;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: Theme.border_radius_pill;
                    background: cam_touch.pressed ? Theme.surface_light : Theme.surface;
                    border-width: 1px;
                    border-color: cam_touch.pressed ? Theme.surface_border_light : Theme.surface_border;

                    animate background, border-color { duration: Theme.anim_fast; }

                    // Vector camera body
                    Rectangle {
                        width: 18px;
                        height: 13px;
                        border-radius: 3px;
                        border-width: 1.5px;
                        border-color: Theme.text_primary;
                        background: transparent;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2 + 1px;

                        // Lens circle
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            border-width: 1.3px;
                            border-color: Theme.text_primary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }

            Text {
                text: "Photo";
                font-family: Theme.font_main;
                font-size: 11px;
                color: Theme.text_secondary;
                horizontal-alignment: center;
            }
        }
    }

    // --- SHORTCUT 4: Applications ---
    if root.show_all_apps: apps_touch := TouchArea {
        width: 68px;
        clicked => { root.open_apps(); }

        VerticalLayout {
            spacing: 6px;
            alignment: center;

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: Theme.border_radius_pill;
                    background: apps_touch.pressed ? Theme.surface_light : Theme.surface;
                    border-width: 1px;
                    border-color: apps_touch.pressed ? Theme.surface_border_light : Theme.surface_border;

                    animate background, border-color { duration: Theme.anim_fast; }

                    // 4 squares icon
                    Rectangle {
                        width: 14px;
                        height: 14px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        background: transparent;

                        Rectangle { x: 0px; y: 0px; width: 5px; height: 5px; border-radius: 1px; background: Theme.text_primary; }
                        Rectangle { x: 9px; y: 0px; width: 5px; height: 5px; border-radius: 1px; background: Theme.text_primary; }
                        Rectangle { x: 0px; y: 9px; width: 5px; height: 5px; border-radius: 1px; background: Theme.text_primary; }
                        Rectangle { x: 9px; y: 9px; width: 5px; height: 5px; border-radius: 1px; background: Theme.text_primary; }
                    }
                }
            }

            Text {
                text: "Applications";
                font-family: Theme.font_main;
                font-size: 11px;
                color: Theme.text_secondary;
                horizontal-alignment: center;
            }
        }
    }
}
