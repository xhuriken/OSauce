import { Theme } from "../styles/theme.slint";
import { StatusBar } from "status_bar.slint";

// Consistent minimalist header for Signals views
export component SignalsHeader inherits VerticalLayout {
    in-out property <string> time_string: "22:48";
    in-out property <string> sec_string: "36";
    in-out property <string> date_string: "Lundi 5 octobre 2026";
    in-out property <int> battery_level: 84;
    in-out property <string> tag: "NOTIFICATIONS / 6 SIGNAUX";
    in-out property <string> title: "Juste l'essentiel.";
    in-out property <string> subtitle: "Un signal, une intention. Le reste attend.";

    spacing: 12px;
    alignment: start;

    // Small persistent top bar
    StatusBar {
        battery_level: root.battery_level;
        is_charging: true;
        show_clock_small: false;
    }

    // Mini sub-header: clock + date
    VerticalLayout {
        spacing: 2px;
        alignment: start;

        HorizontalLayout {
            spacing: 5px;
            alignment: start;

            Text {
                text: root.time_string;
                font-family: Theme.font_main;
                font-size: 22px;
                font-weight: 400;
                color: Theme.text_primary;
                vertical-alignment: center;
            }

            Text {
                text: root.sec_string;
                font-family: Theme.font_mono;
                font-size: 11px;
                font-weight: 600;
                color: Theme.pastel_green;
                vertical-alignment: top;
            }
        }

        Text {
            text: root.date_string;
            font-family: Theme.font_main;
            font-size: 11px;
            color: Theme.text_muted;
        }
    }

    // Category tag
    Text {
        text: root.tag;
        font-family: Theme.font_main;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.2px;
        color: Theme.text_muted;
    }

    // Main poetic title
    Text {
        text: root.title;
        font-family: Theme.font_main;
        font-size: 28px;
        font-weight: 300;
        letter-spacing: -0.5px;
        color: Theme.text_primary;
    }

    // Gentle subtitle
    Text {
        text: root.subtitle;
        font-family: Theme.font_main;
        font-size: 12px;
        color: Theme.text_secondary;
    }
}
