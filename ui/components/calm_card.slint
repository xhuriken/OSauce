import { Theme } from "../styles/theme.slint";

// Peaceful atmospheric landscape card (Lake in the mist with mountain silhouettes)
export component CalmCard inherits Rectangle {
    in-out property <string> caption: "Un peu de silence.";
    in-out property <bool> show_caption: false;

    height: 190px;
    border-radius: Theme.border_radius_xl;
    clip: true;
    background: #0d121c;

    // Atmospheric deep night sky
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(180deg, #090e17 0%, #152233 45%, #2a3a4e 70%, #141f2d 100%);
    }

    // Distant mountain layer (subtle, peaceful silhouette)
    Path {
        width: 100%;
        height: 60px;
        y: 40px;
        fill: #1c2938;

        MoveTo { x: 0; y: 60; }
        LineTo { x: 0; y: 40; }
        LineTo { x: 0.18; y: 22; }
        LineTo { x: 0.35; y: 35; }
        LineTo { x: 0.52; y: 15; }
        LineTo { x: 0.70; y: 32; }
        LineTo { x: 0.88; y: 18; }
        LineTo { x: 1.0; y: 38; }
        LineTo { x: 1.0; y: 60; }
        Close {}
    }

    // Midground mountain layer
    Path {
        width: 100%;
        height: 55px;
        y: 65px;
        fill: #14202c;

        MoveTo { x: 0; y: 55; }
        LineTo { x: 0; y: 30; }
        LineTo { x: 0.25; y: 12; }
        LineTo { x: 0.45; y: 28; }
        LineTo { x: 0.65; y: 8; }
        LineTo { x: 0.85; y: 24; }
        LineTo { x: 1.0; y: 20; }
        LineTo { x: 1.0; y: 55; }
        Close {}
    }

    // Lake surface with soft reflection and mist gradient
    Rectangle {
        width: 100%;
        height: 80px;
        y: parent.height - self.height;
        background: @linear-gradient(180deg, rgba(82, 110, 138, 0.45) 0%, rgba(20, 31, 45, 0.95) 85%);

        // Calming water ripples
        Rectangle {
            width: 70%;
            height: 1px;
            background: rgba(255, 255, 255, 0.08);
            x: (parent.width - self.width) / 2;
            y: 20px;
        }

        Rectangle {
            width: 45%;
            height: 1px;
            background: rgba(255, 255, 255, 0.05);
            x: (parent.width - self.width) / 2;
            y: 36px;
        }
    }

    // Subtle edge border highlight
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.border_radius_xl;
        border-width: 1px;
        border-color: rgba(255, 255, 255, 0.07);
        background: transparent;
    }
}
