import { Theme } from "../styles/theme.slint";

// Minimal system status bar (clock and battery status)
export component StatusBar inherits HorizontalLayout {
    in property <string> time: "09:41";
    in property <string> battery: "100%";

    height: 24px;
    alignment: space-between;

    // Current system time
    Text {
        text: root.time;
        color: Theme.text_primary;
        font-size: 14px;
        font-weight: 600;
        vertical-alignment: center;
    }

    // Flexible layout spacer
    Rectangle { horizontal-stretch: 1; }

    // Battery percentage indicator
    Text {
        text: root.battery;
        color: Theme.success;
        font-size: 14px;
        font-weight: 600;
        vertical-alignment: center;
    }
}
