import { Theme } from "../styles/theme.slint";

// Discrete top status bar (small clock in deep views, cellular bars, battery level)
export component StatusBar inherits HorizontalLayout {
    in-out property <int> battery_level: 84;
    in-out property <bool> is_charging: true;
    in-out property <bool> show_clock_small: false;
    in-out property <string> time_string: "22:48";
    in-out property <string> sec_string: "36";

    height: 20px;
    alignment: space-between;

    // Left: empty spacer on home, small clock in deep views
    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        if root.show_clock_small: HorizontalLayout {
            spacing: 4px;
            alignment: start;

            Text {
                text: root.time_string;
                font-family: Theme.font_mono;
                font-size: 13px;
                font-weight: 700;
                color: Theme.text_primary;
                vertical-alignment: center;
            }

            Text {
                text: root.sec_string;
                font-family: Theme.font_mono;
                font-size: 10px;
                color: Theme.pastel_green;
                vertical-alignment: center;
            }
        }
    }

    // Right: Signal bars and battery percentage
    HorizontalLayout {
        spacing: 8px;
        alignment: end;

        // Minimal cellular signal bars (3 bars)
        HorizontalLayout {
            spacing: 2px;
            alignment: center;

            Rectangle { width: 3px; height: 4px; border-radius: 1px; background: Theme.text_muted; y: 6px; }
            Rectangle { width: 3px; height: 7px; border-radius: 1px; background: Theme.text_muted; y: 3px; }
            Rectangle { width: 3px; height: 10px; border-radius: 1px; background: Theme.text_secondary; y: 0px; }
        }

        // Battery indicator
        HorizontalLayout {
            spacing: 4px;
            alignment: center;

            // Vector battery icon
            Rectangle {
                width: 18px;
                height: 9px;
                border-radius: 2px;
                border-width: 1px;
                border-color: Theme.text_secondary;
                background: transparent;

                // Battery fill
                Rectangle {
                    x: 1.5px;
                    y: 1.5px;
                    height: 5px;
                    width: (parent.width - 3px) * (root.battery_level / 100);
                    border-radius: 1px;
                    background: root.is_charging ? Theme.pastel_green : (root.battery_level < 20 ? Theme.danger : Theme.text_primary);
                }

                // Positive pole pin
                Rectangle {
                    x: parent.width;
                    y: 2.5px;
                    width: 2px;
                    height: 4px;
                    border-radius: 1px;
                    background: Theme.text_secondary;
                }
            }

            Text {
                text: "\{root.battery_level}%";
                font-family: Theme.font_mono;
                font-size: 11px;
                font-weight: 600;
                color: Theme.text_secondary;
                vertical-alignment: center;
            }
        }
    }
}
