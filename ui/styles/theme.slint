// Global design system (colors, metrics, typography)
export global Theme {
    // Dark mode color palette
    out property <color> background: #0f172a;
    out property <color> surface: #1e293b;
    out property <color> surface_light: #334155;
    out property <color> primary: #38bdf8;
    out property <color> text_primary: #f8fafc;
    out property <color> text_secondary: #94a3b8;
    out property <color> success: #4ade80;

    // Layout metrics
    out property <length> border_radius_lg: 24px;
    out property <length> border_radius_md: 16px;
    out property <length> padding_screen: 20px;
}
