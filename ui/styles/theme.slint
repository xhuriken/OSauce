// Global design system (colors, metrics, typography, animations)
export global Theme {
    // Pure dark palette (fond presque noir apaisant)
    out property <color> background: #07080c;
    out property <color> background_elevated: #0d0f17;
    out property <color> surface: rgba(255, 255, 255, 0.035);
    out property <color> surface_light: rgba(255, 255, 255, 0.07);
    out property <color> surface_border: rgba(255, 255, 255, 0.07);
    out property <color> surface_border_light: rgba(255, 255, 255, 0.12);

    // Accents pastel doux (Signaux principaux et complements)
    out property <color> pastel_purple: #c4b5fd;       // Violet pastel doux
    out property <color> pastel_purple_deep: #8b5cf6;  // Violet accent
    out property <color> pastel_purple_glow: rgba(196, 181, 253, 0.18);
    out property <color> pastel_purple_subtle: rgba(196, 181, 253, 0.08);

    out property <color> pastel_green: #86efac;        // Vert doux complementaire
    out property <color> pastel_green_deep: #10b981;   // Vert accent
    out property <color> pastel_green_glow: rgba(134, 239, 172, 0.18);
    out property <color> pastel_green_subtle: rgba(134, 239, 172, 0.08);

    // Primary & legacy accents
    out property <color> primary: #c4b5fd;
    out property <color> primary_glow: rgba(196, 181, 253, 0.15);
    out property <color> secondary: #86efac;
    out property <color> success: #86efac;
    out property <color> warning: #fde047;
    out property <color> danger: #fca5a5;

    // Typography colors
    out property <color> text_primary: #f8fafc;
    out property <color> text_secondary: #94a3b8;
    out property <color> text_muted: #525f7a;
    out property <color> text_dim: #334155;

    // Fonts
    out property <string> font_main: "Inter, Segoe UI, sans-serif";
    out property <string> font_mono: "Bahnschrift, monospace";

    // Layout metrics
    out property <length> border_radius_pill: 9999px;
    out property <length> border_radius_xl: 24px;
    out property <length> border_radius_lg: 16px;
    out property <length> border_radius_md: 12px;
    out property <length> border_radius_sm: 8px;
    out property <length> padding_screen: 24px;

    // Fluid animations
    out property <duration> anim_instant: 90ms;
    out property <duration> anim_fast: 160ms;
    out property <duration> anim_smooth: 280ms;
    out property <duration> anim_spring: 380ms;
}
