import { Theme } from "../styles/theme.slint";
import { SignalsHeader } from "../components/signals_header.slint";

// Signals View: Single Group Focused ("Repondre" - une seule chose a la fois)
export component SignalsGroupView inherits VerticalLayout {
    in-out property <string> time_string: "22:48";
    in-out property <string> sec_string: "36";
    in-out property <string> date_string: "Lundi 5 octobre 2026";
    in-out property <int> battery_level: 84;
    in-out property <string> group_name: "Repondre";

    callback close_group();
    callback mask_group();
    callback action_item(string); // "lea", "papa", "maya"

    spacing: 0px;
    alignment: space-between;

    // Header
    SignalsHeader {
        time_string: root.time_string;
        sec_string: root.sec_string;
        date_string: root.date_string;
        battery_level: root.battery_level;
        tag: "INTENTIONS / GROUPE OUVERT";
        title: "\{root.group_name}.";
        subtitle: "Trois liens. Toute votre attention.";
    }

    // List of 3 items
    VerticalLayout {
        spacing: 12px;
        alignment: start;
        padding-top: 8px;

        // Item 1: Lea
        item1_touch := TouchArea {
            height: 64px;
            clicked => { root.action_item("lea"); }

            Rectangle {
                width: 100%;
                height: 100%;
                background: item1_touch.pressed ? Theme.surface_light : transparent;
                border-radius: Theme.border_radius_md;

                VerticalLayout {
                    alignment: space-between;
                    padding-bottom: 8px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "· Lea";
                            font-family: Theme.font_main;
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.pastel_purple;
                        }
                        Text {
                            text: "22:41";
                            font-family: Theme.font_mono;
                            font-size: 11px;
                            color: Theme.text_muted;
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Bien rentree ?";
                            font-family: Theme.font_main;
                            font-size: 17px;
                            font-weight: 300;
                            color: Theme.text_primary;
                        }
                        Text {
                            text: "Repondre  ^";
                            font-family: Theme.font_main;
                            font-size: 11px;
                            color: Theme.text_secondary;
                        }
                    }

                    Text {
                        text: "Message";
                        font-family: Theme.font_main;
                        font-size: 10px;
                        color: Theme.text_muted;
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.surface_border; }

        // Item 2: Papa
        item2_touch := TouchArea {
            height: 64px;
            clicked => { root.action_item("papa"); }

            Rectangle {
                width: 100%;
                height: 100%;
                background: item2_touch.pressed ? Theme.surface_light : transparent;
                border-radius: Theme.border_radius_md;

                VerticalLayout {
                    alignment: space-between;
                    padding-bottom: 8px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "· Papa";
                            font-family: Theme.font_main;
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.pastel_purple;
                        }
                        Text {
                            text: "21:56";
                            font-family: Theme.font_mono;
                            font-size: 11px;
                            color: Theme.text_muted;
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Appelle-moi demain.";
                            font-family: Theme.font_main;
                            font-size: 17px;
                            font-weight: 300;
                            color: Theme.text_primary;
                        }
                        Text {
                            text: "Repondre  ^";
                            font-family: Theme.font_main;
                            font-size: 11px;
                            color: Theme.text_secondary;
                        }
                    }

                    Text {
                        text: "Message";
                        font-family: Theme.font_main;
                        font-size: 10px;
                        color: Theme.text_muted;
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.surface_border; }

        // Item 3: Maya
        item3_touch := TouchArea {
            height: 64px;
            clicked => { root.action_item("maya"); }

            Rectangle {
                width: 100%;
                height: 100%;
                background: item3_touch.pressed ? Theme.surface_light : transparent;
                border-radius: Theme.border_radius_md;

                VerticalLayout {
                    alignment: space-between;
                    padding-bottom: 8px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "· Maya";
                            font-family: Theme.font_main;
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.pastel_purple;
                        }
                        Text {
                            text: "22:12";
                            font-family: Theme.font_mono;
                            font-size: 11px;
                            color: Theme.text_muted;
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Un cafe demain ?";
                            font-family: Theme.font_main;
                            font-size: 17px;
                            font-weight: 300;
                            color: Theme.text_primary;
                        }
                        Text {
                            text: "Repondre  ^";
                            font-family: Theme.font_main;
                            font-size: 11px;
                            color: Theme.text_secondary;
                        }
                    }

                    Text {
                        text: "Message";
                        font-family: Theme.font_main;
                        font-size: 10px;
                        color: Theme.text_muted;
                    }
                }
            }
        }
    }

    // Peaceful reassurance footnote
    VerticalLayout {
        spacing: 6px;
        padding-top: 14px;
        padding-bottom: 14px;

        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            // Soft leaf icon
            Path {
                width: 12px;
                height: 12px;
                y: 1px;
                stroke: Theme.pastel_green;
                stroke-width: 1.2px;

                MoveTo { x: 1; y: 11; }
                LineTo { x: 11; y: 1; }
                LineTo { x: 11; y: 7; }
                LineTo { x: 6; y: 11; }
                Close {}
            }

            Text {
                text: "Les 3 autres signaux s'effacent.";
                font-family: Theme.font_main;
                font-size: 11px;
                font-weight: 600;
                color: Theme.pastel_green;
            }
        }

        Text {
            text: "Prevoir et Pour soi restent a l'abri. Repliez ce groupe pour les retrouver.";
            font-family: Theme.font_main;
            font-size: 11px;
            color: Theme.text_muted;
            wrap: word-wrap;
        }
    }

    // Bottom actions: Replier & Masquer
    HorizontalLayout {
        alignment: space-between;
        padding-bottom: 24px;
        padding-left: 4px;
        padding-right: 4px;

        fold_touch := TouchArea {
            clicked => { root.close_group(); }

            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Text {
                    text: "-  Replier";
                    font-family: Theme.font_main;
                    font-size: 13px;
                    font-weight: 500;
                    color: fold_touch.pressed ? Theme.text_primary : Theme.text_secondary;
                }
            }
        }

        mask_touch := TouchArea {
            clicked => { root.mask_group(); }

            HorizontalLayout {
                spacing: 6px;
                alignment: end;

                Text {
                    text: "Masquer ce groupe";
                    font-family: Theme.font_main;
                    font-size: 12px;
                    color: mask_touch.pressed ? Theme.text_primary : Theme.text_muted;
                }
            }
        }
    }
}
