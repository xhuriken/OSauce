import { Theme } from "../styles/theme.slint";
import { StatusBar } from "../components/status_bar.slint";

// Native Apps and Store View for OSauce Shell
export component AppsView inherits VerticalLayout {
    in-out property <string> time_string: "22:48";
    in-out property <string> sec_string: "36";
    in-out property <string> date_string: "Lundi 5 octobre 2026";
    in-out property <int> battery_level: 84;
    in-out property <int> active_tab: 0; // 0 = Mes Applications, 1 = Store & Catalogue
    in-out property <string> search_query: "";

    // App state callbacks for Rust backend
    callback return_home();
    callback launch_app(string);
    callback install_app(string, string);
    callback uninstall_app(string);

    spacing: 0px;
    alignment: start;

    // --- TOP STATUS BAR ---
    StatusBar {
        time_string: root.time_string;
        sec_string: root.sec_string;
        battery_level: root.battery_level;
        is_charging: false;
        show_clock_small: true;
    }

    // --- MAIN SCROLLABLE CONTENT ---
    VerticalLayout {
        padding-left: Theme.padding_screen;
        padding-right: Theme.padding_screen;
        padding-top: 14px;
        padding-bottom: 24px;
        spacing: 16px;

        // Navigation Header: Back button + Screen Title
        HorizontalLayout {
            alignment: space-between;

            back_touch := TouchArea {
                width: 90px;
                height: 36px;
                clicked => { root.return_home(); }

                Rectangle {
                    border-radius: Theme.border_radius_pill;
                    background: back_touch.pressed ? Theme.surface_light : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.surface_border;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        padding-left: 10px;
                        padding-right: 12px;

                        // Left chevron path
                        Path {
                            width: 8px;
                            height: 12px;
                            y: (parent.height - self.height) / 2;
                            stroke: Theme.pastel_purple;
                            stroke-width: 1.8px;

                            MoveTo { x: 7; y: 1; }
                            LineTo { x: 1; y: 6; }
                            LineTo { x: 7; y: 11; }
                        }

                        Text {
                            text: "Accueil";
                            font-family: Theme.font_main;
                            font-size: 13px;
                            font-weight: 500;
                            color: Theme.text_primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Text {
                text: "APPLICATIONS";
                font-family: Theme.font_mono;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 2px;
                color: Theme.text_muted;
                vertical-alignment: center;
            }
        }

        // Title and description
        VerticalLayout {
            spacing: 4px;

            Text {
                text: root.active_tab == 0 ? "Mes Applications" : "Store Integre";
                font-family: Theme.font_main;
                font-size: 24px;
                font-weight: 600;
                color: Theme.text_primary;
            }

            Text {
                text: root.active_tab == 0 
                    ? "Lancez vos applications mobiles directement depuis OSauce" 
                    : "Installez des applications libres et respectueuses en un clic";
                font-family: Theme.font_main;
                font-size: 12px;
                color: Theme.text_secondary;
            }
        }

        // Segmented Switch: Mes Applications vs Store
        Rectangle {
            height: 42px;
            border-radius: Theme.border_radius_pill;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.surface_border;

            HorizontalLayout {
                padding: 3px;
                spacing: 4px;

                tab_0_touch := TouchArea {
                    horizontal-stretch: 1;
                    clicked => { root.active_tab = 0; }

                    Rectangle {
                        border-radius: Theme.border_radius_pill;
                        background: root.active_tab == 0 ? Theme.surface_light : transparent;
                        border-width: root.active_tab == 0 ? 1px : 0px;
                        border-color: root.active_tab == 0 ? Theme.surface_border_light : transparent;

                        animate background { duration: Theme.anim_fast; }

                        Text {
                            text: "Installees";
                            font-family: Theme.font_main;
                            font-size: 13px;
                            font-weight: root.active_tab == 0 ? 600 : 400;
                            color: root.active_tab == 0 ? Theme.text_primary : Theme.text_secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                tab_1_touch := TouchArea {
                    horizontal-stretch: 1;
                    clicked => { root.active_tab = 1; }

                    Rectangle {
                        border-radius: Theme.border_radius_pill;
                        background: root.active_tab == 1 ? Theme.surface_light : transparent;
                        border-width: root.active_tab == 1 ? 1px : 0px;
                        border-color: root.active_tab == 1 ? Theme.surface_border_light : transparent;

                        animate background { duration: Theme.anim_fast; }

                        Text {
                            text: "Decouvrir & Store";
                            font-family: Theme.font_main;
                            font-size: 13px;
                            font-weight: root.active_tab == 1 ? 600 : 400;
                            color: root.active_tab == 1 ? Theme.text_primary : Theme.text_secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // --- TAB 0: INSTALLED APPLICATIONS LIST ---
        if root.active_tab == 0: VerticalLayout {
            spacing: 10px;

            // App Item 1: F-Droid
            Rectangle {
                height: 72px;
                border-radius: Theme.border_radius_lg;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.surface_border;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;
                    alignment: space-between;

                    // App Badge Icon
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: Theme.border_radius_md;
                            background: rgba(196, 181, 253, 0.12);
                            border-width: 1px;
                            border-color: rgba(196, 181, 253, 0.25);

                            Text {
                                text: "FD";
                                font-family: Theme.font_mono;
                                font-size: 16px;
                                font-weight: 700;
                                color: Theme.pastel_purple;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Metadata
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        alignment: center;

                        Text {
                            text: "F-Droid";
                            font-family: Theme.font_main;
                            font-size: 15px;
                            font-weight: 600;
                            color: Theme.text_primary;
                        }

                        Text {
                            text: "Depot d'applications libres | 12 Mo";
                            font-family: Theme.font_main;
                            font-size: 11px;
                            color: Theme.text_secondary;
                        }
                    }

                    // Launch button
                    VerticalLayout {
                        alignment: center;
                        launch_fdroid := TouchArea {
                            width: 76px;
                            height: 34px;
                            clicked => { root.launch_app("org.fdroid.fdroid"); }

                            Rectangle {
                                border-radius: Theme.border_radius_pill;
                                background: launch_fdroid.pressed ? Theme.pastel_green_deep : Theme.pastel_green_subtle;
                                border-width: 1px;
                                border-color: Theme.pastel_green;

                                Text {
                                    text: "Ouvrir";
                                    font-family: Theme.font_main;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: launch_fdroid.pressed ? #000000 : Theme.pastel_green;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // App Item 2: Navigateur Web Jelly
            Rectangle {
                height: 72px;
                border-radius: Theme.border_radius_lg;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.surface_border;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: Theme.border_radius_md;
                            background: rgba(134, 239, 172, 0.12);
                            border-width: 1px;
                            border-color: rgba(134, 239, 172, 0.25);

                            Text {
                                text: "WB";
                                font-family: Theme.font_mono;
                                font-size: 16px;
                                font-weight: 700;
                                color: Theme.pastel_green;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        alignment: center;

                        Text {
                            text: "Navigateur Web";
                            font-family: Theme.font_main;
                            font-size: 15px;
                            font-weight: 600;
                            color: Theme.text_primary;
                        }

                        Text {
                            text: "Navigation legere LineageOS | 4 Mo";
                            font-family: Theme.font_main;
                            font-size: 11px;
                            color: Theme.text_secondary;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        launch_jelly := TouchArea {
                            width: 76px;
                            height: 34px;
                            clicked => { root.launch_app("org.lineageos.jelly"); }

                            Rectangle {
                                border-radius: Theme.border_radius_pill;
                                background: launch_jelly.pressed ? Theme.surface_light : Theme.surface;
                                border-width: 1px;
                                border-color: Theme.surface_border_light;

                                Text {
                                    text: "Ouvrir";
                                    font-family: Theme.font_main;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text_primary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // App Item 3: Messages & SMS
            Rectangle {
                height: 72px;
                border-radius: Theme.border_radius_lg;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.surface_border;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: Theme.border_radius_md;
                            background: rgba(253, 224, 71, 0.12);
                            border-width: 1px;
                            border-color: rgba(253, 224, 71, 0.25);

                            Text {
                                text: "MS";
                                font-family: Theme.font_mono;
                                font-size: 16px;
                                font-weight: 700;
                                color: Theme.warning;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        alignment: center;

                        Text {
                            text: "Messages & SMS";
                            font-family: Theme.font_main;
                            font-size: 15px;
                            font-weight: 600;
                            color: Theme.text_primary;
                        }

                        Text {
                            text: "Messagerie SMS native | 3 Mo";
                            font-family: Theme.font_main;
                            font-size: 11px;
                            color: Theme.text_secondary;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        launch_msg := TouchArea {
                            width: 76px;
                            height: 34px;
                            clicked => { root.launch_app("com.android.messaging"); }

                            Rectangle {
                                border-radius: Theme.border_radius_pill;
                                background: launch_msg.pressed ? Theme.surface_light : Theme.surface;
                                border-width: 1px;
                                border-color: Theme.surface_border_light;

                                Text {
                                    text: "Ouvrir";
                                    font-family: Theme.font_main;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text_primary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // App Item 4: Parametres Android
            Rectangle {
                height: 72px;
                border-radius: Theme.border_radius_lg;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.surface_border;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 44px;
                            height: 44px;
                            border-radius: Theme.border_radius_md;
                            background: rgba(255, 255, 255, 0.06);
                            border-width: 1px;
                            border-color: Theme.surface_border;

                            Text {
                                text: "CF";
                                font-family: Theme.font_mono;
                                font-size: 16px;
                                font-weight: 700;
                                color: Theme.text_secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        alignment: center;

                        Text {
                            text: "Configuration Systeme";
                            font-family: Theme.font_main;
                            font-size: 15px;
                            font-weight: 600;
                            color: Theme.text_primary;
                        }

                        Text {
                            text: "Parametres du conteneur Waydroid";
                            font-family: Theme.font_main;
                            font-size: 11px;
                            color: Theme.text_secondary;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        launch_settings := TouchArea {
                            width: 76px;
                            height: 34px;
                            clicked => { root.launch_app("com.android.settings"); }

                            Rectangle {
                                border-radius: Theme.border_radius_pill;
                                background: launch_settings.pressed ? Theme.surface_light : Theme.surface;
                                border-width: 1px;
                                border-color: Theme.surface_border_light;

                            Text {
                                text: "Ouvrir";
                                font-family: Theme.font_main;
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.text_primary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    }
                }
            }
        }

        // --- TAB 1: INTEGRATED STORE & CATALOGUE ---
        if root.active_tab == 1: VerticalLayout {
            spacing: 10px;

            // Store Item 1: Signal
            Rectangle {
                height: 82px;
                border-radius: Theme.border_radius_lg;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.surface_border;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 46px;
                            height: 46px;
                            border-radius: Theme.border_radius_md;
                            background: rgba(196, 181, 253, 0.15);
                            border-width: 1px;
                            border-color: rgba(196, 181, 253, 0.3);

                            Text {
                                text: "SG";
                                font-family: Theme.font_mono;
                                font-size: 17px;
                                font-weight: 700;
                                color: Theme.pastel_purple;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        alignment: center;

                        HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: "Signal";
                                font-family: Theme.font_main;
                                font-size: 15px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }

                            Rectangle {
                                height: 16px;
                                border-radius: 4px;
                                background: Theme.pastel_purple_subtle;
                                border-width: 1px;
                                border-color: rgba(196, 181, 253, 0.2);

                                Text {
                                    text: "VIE PRIVEE";
                                    font-family: Theme.font_mono;
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: Theme.pastel_purple;
                                    
                                    
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Text {
                            text: "Messagerie privee chiffree de bout en bout";
                            font-family: Theme.font_main;
                            font-size: 11px;
                            color: Theme.text_secondary;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        install_signal := TouchArea {
                            width: 82px;
                            height: 34px;
                            clicked => { root.install_app("Signal", "https://updates.signal.org/android/latest.apk"); }

                            Rectangle {
                                border-radius: Theme.border_radius_pill;
                                background: install_signal.pressed ? Theme.pastel_purple_deep : Theme.pastel_purple_subtle;
                                border-width: 1px;
                                border-color: Theme.pastel_purple;

                                Text {
                                    text: "Installer";
                                    font-family: Theme.font_main;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: install_signal.pressed ? #000000 : Theme.pastel_purple;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // Store Item 2: VLC
            Rectangle {
                height: 82px;
                border-radius: Theme.border_radius_lg;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.surface_border;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 46px;
                            height: 46px;
                            border-radius: Theme.border_radius_md;
                            background: rgba(253, 224, 71, 0.12);
                            border-width: 1px;
                            border-color: rgba(253, 224, 71, 0.25);

                            Text {
                                text: "VLC";
                                font-family: Theme.font_mono;
                                font-size: 14px;
                                font-weight: 700;
                                color: Theme.warning;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        alignment: center;

                        HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: "VLC Player";
                                font-family: Theme.font_main;
                                font-size: 15px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }

                            Rectangle {
                                height: 16px;
                                border-radius: 4px;
                                background: rgba(253, 224, 71, 0.1);
                                border-width: 1px;
                                border-color: rgba(253, 224, 71, 0.2);

                                Text {
                                    text: "MEDIA";
                                    font-family: Theme.font_mono;
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: Theme.warning;
                                    
                                    
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Text {
                            text: "Lecteur audio et video universel sans pub";
                            font-family: Theme.font_main;
                            font-size: 11px;
                            color: Theme.text_secondary;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        install_vlc := TouchArea {
                            width: 82px;
                            height: 34px;
                            clicked => { root.install_app("VLC", "https://get.videolan.org/vlc-android/latest.apk"); }

                            Rectangle {
                                border-radius: Theme.border_radius_pill;
                                background: install_vlc.pressed ? Theme.surface_light : Theme.surface;
                                border-width: 1px;
                                border-color: Theme.surface_border_light;

                                Text {
                                    text: "Installer";
                                    font-family: Theme.font_main;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text_primary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // Store Item 3: OpenTracks
            Rectangle {
                height: 82px;
                border-radius: Theme.border_radius_lg;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.surface_border;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 46px;
                            height: 46px;
                            border-radius: Theme.border_radius_md;
                            background: rgba(134, 239, 172, 0.12);
                            border-width: 1px;
                            border-color: rgba(134, 239, 172, 0.25);

                            Text {
                                text: "OT";
                                font-family: Theme.font_mono;
                                font-size: 17px;
                                font-weight: 700;
                                color: Theme.pastel_green;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        alignment: center;

                        HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: "OpenTracks";
                                font-family: Theme.font_main;
                                font-size: 15px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }

                            Rectangle {
                                height: 16px;
                                border-radius: 4px;
                                background: Theme.pastel_green_subtle;
                                border-width: 1px;
                                border-color: rgba(134, 239, 172, 0.2);

                                Text {
                                    text: "HORS-LIGNE";
                                    font-family: Theme.font_mono;
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: Theme.pastel_green;
                                    
                                    
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Text {
                            text: "Traceur GPS et sport 100% autonome et local";
                            font-family: Theme.font_main;
                            font-size: 11px;
                            color: Theme.text_secondary;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        install_ot := TouchArea {
                            width: 82px;
                            height: 34px;
                            clicked => { root.install_app("OpenTracks", "https://f-droid.org/repo/de.dennisguse.opentracks.apk"); }

                            Rectangle {
                                border-radius: Theme.border_radius_pill;
                                background: install_ot.pressed ? Theme.surface_light : Theme.surface;
                                border-width: 1px;
                                border-color: Theme.surface_border_light;

                                Text {
                                    text: "Installer";
                                    font-family: Theme.font_main;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text_primary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // Store Item 4: Simple Calendar
            Rectangle {
                height: 82px;
                border-radius: Theme.border_radius_lg;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.surface_border;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 12px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 46px;
                            height: 46px;
                            border-radius: Theme.border_radius_md;
                            background: rgba(196, 181, 253, 0.12);
                            border-width: 1px;
                            border-color: rgba(196, 181, 253, 0.25);

                            Text {
                                text: "CAL";
                                font-family: Theme.font_mono;
                                font-size: 15px;
                                font-weight: 700;
                                color: Theme.pastel_purple;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        alignment: center;

                        HorizontalLayout {
                            spacing: 6px;

                            Text {
                                text: "Simple Calendar";
                                font-family: Theme.font_main;
                                font-size: 15px;
                                font-weight: 600;
                                color: Theme.text_primary;
                            }

                            Rectangle {
                                height: 16px;
                                border-radius: 4px;
                                background: Theme.pastel_purple_subtle;
                                border-width: 1px;
                                border-color: rgba(196, 181, 253, 0.2);

                                Text {
                                    text: "SOBRE";
                                    font-family: Theme.font_mono;
                                    font-size: 9px;
                                    font-weight: 700;
                                    color: Theme.pastel_purple;
                                    
                                    
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Text {
                            text: "Agenda sans publicite ni acces reseau";
                            font-family: Theme.font_main;
                            font-size: 11px;
                            color: Theme.text_secondary;
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        install_cal := TouchArea {
                            width: 82px;
                            height: 34px;
                            clicked => { root.install_app("Calendar", "https://f-droid.org/repo/com.simplemobiletools.calendar.pro.apk"); }

                            Rectangle {
                                border-radius: Theme.border_radius_pill;
                                background: install_cal.pressed ? Theme.surface_light : Theme.surface;
                                border-width: 1px;
                                border-color: Theme.surface_border_light;

                                Text {
                                    text: "Installer";
                                    font-family: Theme.font_main;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.text_primary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
