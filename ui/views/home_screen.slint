import { Theme } from "../styles/theme.slint";

// Ultra-minimalist, fluid, pure lockscreen and homescreen for OSauce
export component HomeScreen inherits VerticalLayout {
    in-out property <bool> is_unlocked: false;
    in-out property <bool> show_seconds: false;

    // Callbacks to communicate with Rust backend
    callback request_unlock();
    callback request_lock();

    // Live clock properties (incremented by Timer)
    in-out property <int> hours: 9;
    in-out property <int> minutes: 41;
    in-out property <int> seconds: 28;
    in-out property <bool> colon_tick: true;
    in-out property <string> date_string: "MERCREDI 30 SEPTEMBRE";

    // Autonomous 1-second live clock timer
    Timer {
        interval: 1s;
        running: true;
        triggered => {
            root.seconds += 1;
            root.colon_tick = !root.colon_tick;
            if root.seconds >= 60 {
                root.seconds = 0;
                root.minutes += 1;
                if root.minutes >= 60 {
                    root.minutes = 0;
                    root.hours = (root.hours + 1);
                    if root.hours >= 24 {
                        root.hours = 0;
                    }
                }
            }
        }
    }

    alignment: space-between;
    padding-top: 36px;
    padding-bottom: 20px;

    // --- TOP AREA : Real Moving Clock & Minimal Typography ---
    VerticalLayout {
        spacing: 10px;
        alignment: center;

        // Interactive Tap on Clock toggles live seconds mode
        clock_touch := TouchArea {
            clicked => {
                root.show_seconds = !root.show_seconds;
            }

            VerticalLayout {
                spacing: 6px;
                alignment: center;

                // Time digits row
                HorizontalLayout {
                    spacing: 2px;
                    alignment: center;

                    // Hours (always 2 digits)
                    Text {
                        text: (root.hours < 10 ? "0" : "") + "\{root.hours}";
                        font-family: Theme.font_mono;
                        font-size: 82px;
                        font-weight: 800;
                        color: Theme.text_primary;
                        vertical-alignment: center;
                    }

                    // Ticking breathing colon separator
                    Text {
                        text: ":";
                        font-family: Theme.font_mono;
                        font-size: 82px;
                        font-weight: 800;
                        color: Theme.primary;
                        opacity: root.colon_tick ? 1.0 : 0.25;
                        vertical-alignment: center;

                        animate opacity {
                            duration: 320ms;
                            easing: ease-in-out;
                        }
                    }

                    // Minutes (always 2 digits)
                    Text {
                        text: (root.minutes < 10 ? "0" : "") + "\{root.minutes}";
                        font-family: Theme.font_mono;
                        font-size: 82px;
                        font-weight: 800;
                        color: Theme.text_primary;
                        vertical-alignment: center;
                    }

                    // Optional live ticking seconds (revealed on click)
                    if root.show_seconds: HorizontalLayout {
                        spacing: 2px;
                        alignment: center;

                        Text {
                            text: ":";
                            font-family: Theme.font_mono;
                            font-size: 42px;
                            font-weight: 700;
                            color: Theme.secondary;
                            opacity: 0.7;
                            vertical-alignment: center;
                        }

                        Text {
                            text: (root.seconds < 10 ? "0" : "") + "\{root.seconds}";
                            font-family: Theme.font_mono;
                            font-size: 42px;
                            font-weight: 700;
                            color: Theme.secondary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Clean minimal date text
                Text {
                    text: root.date_string;
                    font-family: Theme.font_main;
                    font-size: 12px;
                    font-weight: 600;
                    letter-spacing: 2px;
                    color: Theme.text_secondary;
                    horizontal-alignment: center;
                }

                // Minimal hint text (subtle indicator)
                Text {
                    text: root.show_seconds ? "SECONDES ACTIVES" : "TOUCHER POUR SECONDES";
                    font-family: Theme.font_main;
                    font-size: 9px;
                    font-weight: 700;
                    letter-spacing: 1.5px;
                    color: clock_touch.has-hover ? Theme.primary : Theme.text_muted;
                    horizontal-alignment: center;

                    animate color { duration: Theme.anim_fast; }
                }
            }
        }
    }

    // --- CENTER AREA : Generous Calm Negative Space ---
    Rectangle {
        vertical-stretch: 1;

        if root.is_unlocked: VerticalLayout {
            alignment: center;
            spacing: 16px;

            Text {
                text: "OSAUCE SHELL";
                font-family: Theme.font_main;
                font-size: 20px;
                font-weight: 800;
                letter-spacing: 3px;
                color: Theme.primary;
                horizontal-alignment: center;
            }

            Text {
                text: "SYSTEME DEVERROUILLE";
                font-family: Theme.font_main;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 1px;
                color: Theme.text_secondary;
                horizontal-alignment: center;
            }

            // Quick re-lock button
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 130px;
                    height: 34px;
                    border-radius: Theme.border_radius_pill;
                    background: relock_touch.pressed ? Theme.surface_light : Theme.surface;
                    border-width: 1px;
                    border-color: Theme.surface_border_accent;

                    animate background { duration: Theme.anim_instant; }

                    Text {
                        text: "VERROUILLER";
                        font-family: Theme.font_main;
                        font-size: 10px;
                        font-weight: 700;
                        color: Theme.text_primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    relock_touch := TouchArea {
                        clicked => {
                            root.is_unlocked = false;
                            root.request_lock();
                        }
                    }
                }
            }
        }
    }

    // --- BOTTOM AREA : Tactile Gesture Bar Unlock Experience ---
    VerticalLayout {
        spacing: 12px;
        alignment: center;

        if !root.is_unlocked: unlock_touch := TouchArea {
            clicked => {
                root.is_unlocked = true;
                root.request_unlock();
            }

            VerticalLayout {
                spacing: 10px;
                alignment: center;
                padding-top: 8px;
                padding-bottom: 8px;

                // Minimal vector padlock status
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    // Minimal vector lock icon
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 10px;
                            height: 9px;
                            border-radius: 2px;
                            border-width: 1.4px;
                            border-color: unlock_touch.pressed ? Theme.primary : Theme.text_muted;
                            background: transparent;

                            // Lock shackle arch
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                border-width: 1.4px;
                                border-color: unlock_touch.pressed ? Theme.primary : Theme.text_muted;
                                x: (parent.width - self.width) / 2;
                                y: -4px;
                                background: transparent;
                            }
                        }
                    }

                    Text {
                        text: unlock_touch.pressed ? "RELACHER POUR OUVRIR" : "TOUCHER POUR DEVERROUILLER";
                        font-family: Theme.font_main;
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 1.5px;
                        color: unlock_touch.pressed ? Theme.primary : Theme.text_muted;
                        vertical-alignment: center;

                        animate color { duration: Theme.anim_instant; }
                    }
                }

                // Minimal Sleek Gesture Pill Handle (Expands with spring feel on press)
                HorizontalLayout {
                    alignment: center;

                    Rectangle {
                        width: unlock_touch.pressed ? 180px : 130px;
                        height: unlock_touch.pressed ? 6px : 4px;
                        border-radius: Theme.border_radius_pill;
                        background: unlock_touch.pressed ? Theme.primary : Theme.text_primary;
                        opacity: unlock_touch.pressed ? 1.0 : 0.7;

                        animate width, height, background, opacity {
                            duration: Theme.anim_fast;
                            easing: ease-out;
                        }
                    }
                }
            }
        }
    }
}
